# Copy this file to .env and fill in your real values

# Get a free MongoDB Atlas cluster at https://www.mongodb.com/cloud/atlas/register
# Then use the connection string it gives you, e.g.:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smarthire-pro
MONGO_URI=

PORT=5000

# Optional: get a key at https://console.anthropic.com/settings/keys
# If left blank, the app automatically falls back to rule-based
# interview question generation (still fully functional).
ANTHROPIC_API_KEY=
